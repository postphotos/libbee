# CENSUS_API_KEY is DEV-ONLY — you do NOT need it to use libbee.
#
# It's required only to (re)build the optional `county_equity` table from the
# US Census API (i.e. when regenerating the bundled data / building the wheel).
# Loading prebuilt data, and building every other table, works without it.
#
# Free key (takes a minute): https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=KEYGOESHERE
